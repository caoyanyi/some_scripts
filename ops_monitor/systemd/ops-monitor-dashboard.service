[Unit]
Description=Ops monitor dashboard
After=network-online.target ops-monitor.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
ExecStart=/usr/bin/env python3 __PROJECT_DIR__/ops_monitor/ops_dashboard.py -c /etc/ops-monitor/config.json --host 0.0.0.0 --port 8765
Restart=always
RestartSec=10
User=root
Nice=5

[Install]
WantedBy=multi-user.target
